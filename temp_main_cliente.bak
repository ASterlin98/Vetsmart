<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel del Cliente | VetSmart</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #2c5530;
      --primary-light: #4a7856;
      --secondary: #8b7355;
      --dark: #2d3748;
      --light: #f8f9fa;
      --gray: #718096;
      --gray-light: #e2e8f0;
      --gray-lighter: #f7fafc;
      --border-radius: 10px;
      --shadow: 0 2px 10px rgba(0, 0, 0, 0.05);
      --transition: all 0.2s ease;
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
      background-color: var(--gray-lighter);
      color: var(--dark);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    /* Header */
    .header {
      background: white;
      color: var(--dark);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 70px;
      z-index: 1000;
      box-shadow: var(--shadow);
      border-bottom: 1px solid var(--gray-light);
    }
    
    .header h1 {
      font-size: 1.5rem;
      font-weight: 600;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--primary);
    }
    
    .header h1 i {
      font-size: 1.3rem;
      color: var(--secondary);
    }
    
    .btn-logout {
      background: transparent;
      border: 1px solid var(--gray-light);
      color: var(--gray);
      padding: 0.5rem 1rem;
      border-radius: var(--border-radius);
      font-weight: 500;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .btn-logout:hover {
      background: var(--gray-lighter);
      color: var(--dark);
      border-color: var(--gray);
    }
    
    /* Main Layout */
    .wrapper {
      display: flex;
      width: 100%;
      margin-top: 70px;
      min-height: calc(100vh - 70px);
    }
    
    /* Sidebar */
    .sidebar {
      width: 280px;
      background: white;
      color: var(--dark);
      display: flex;
      flex-direction: column;
      padding: 2rem 1.5rem;
      min-height: calc(100vh - 70px);
      box-shadow: var(--shadow);
      transition: var(--transition);
      z-index: 900;
      border-right: 1px solid var(--gray-light);
    }
    
    .user-info {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--gray-light);
    }
    
    .user-info h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
      color: var(--dark);
    }
    
    .user-info p {
      color: var(--gray);
      font-size: 0.9rem;
    }
    
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0.85rem 1rem;
      border-radius: var(--border-radius);
      color: var(--dark);
      text-decoration: none;
      font-weight: 500;
      transition: var(--transition);
    }
    
    .nav-item i {
      width: 20px;
      text-align: center;
      font-size: 1.1rem;
      color: var(--gray);
    }
    
    .nav-item:hover {
      background-color: var(--gray-lighter);
      color: var(--primary);
    }
    
    .nav-item:hover i {
      color: var(--primary);
    }
    
    .nav-item.active {
      background-color: var(--primary);
      color: white;
    }
    
    .nav-item.active i {
      color: white;
    }
    
    /* Content Area */
    .content {
      flex: 1;
      padding: 2rem;
      background-color: var(--gray-lighter);
      overflow-y: auto;
    }
    
    .main-content {
      background: white;
      border-radius: var(--border-radius);
      box-shadow: var(--shadow);
      padding: 2rem;
      min-height: 70vh;
      border: 1px solid var(--gray-light);
    }
    
    /* Footer */
    footer {
      text-align: center;
      margin-top: 2rem;
      padding: 1.5rem;
      font-size: 0.9rem;
      color: var(--gray);
      border-top: 1px solid var(--gray-light);
    }
    
    /* Responsive Design */
    @media (max-width: 992px) {
      .sidebar {
        width: 240px;
      }
    }
    
    @media (max-width: 768px) {
      .wrapper {
        flex-direction: column;
      }
      
      .sidebar {
        width: 100%;
        min-height: auto;
        padding: 1.5rem;
      }
      
      .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
      }
      
      .nav-item {
        flex: 1;
        min-width: 140px;
        justify-content: center;
        text-align: center;
      }
      
      .content {
        padding: 1.5rem;
      }
      
      .header {
        padding: 1rem 1.5rem;
      }
      
      .header h1 {
        font-size: 1.3rem;
      }
    }
    
    @media (max-width: 576px) {
      .sidebar-nav {
        flex-direction: column;
      }
      
      .nav-item {
        min-width: 100%;
      }
      
      .header {
        padding: 1rem;
      }
      
      .header h1 {
        font-size: 1.2rem;
      }
      
      .content {
        padding: 1rem;
      }
      
      .main-content {
        padding: 1.5rem;
      }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="header">
    <h1><i class="fas fa-paw"></i> VetSmart</h1>
    <a href="/vetsmart/logout" class="btn-logout">
      <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
    </a>
  </header>

  <div class="wrapper">
    <!-- Sidebar -->
    <div class="sidebar">
      <div class="user-info">
        <h2>Bienvenido, <?= htmlspecialchars($_SESSION['user']['nombre'] ?? '') ?> <?= htmlspecialchars($_SESSION['user']['apellido'] ?? '') ?></h2>
        <p>Panel de Control del Cliente</p>
      </div>
      
      <nav class="sidebar-nav">
        <a href="/vetsmart/cliente/dashboard" class="nav-item active">
          <i class="fas fa-home"></i>
          <span>Dashboard</span>
        </a>
        <a href="/vetsmart/cliente/citas" class="nav-item">
          <i class="fas fa-calendar-alt"></i>
          <span>Mis Citas</span>
        </a>
        <a href="/vetsmart/cliente/mascotas" class="nav-item">
          <i class="fas fa-paw"></i>
          <span>Mis Mascotas</span>
        </a>
        <a href="/vetsmart/cliente/historial" class="nav-item">
          <i class="fas fa-file-medical"></i>
          <span>Historial Clínico</span>
        </a>
        <a href="/vetsmart/cliente/pagos" class="nav-item">
          <i class="fas fa-credit-card"></i>
          <span>Pagos</span>
        </a>
        <a href="/vetsmart/cliente/reportes" class="nav-item">
          <i class="fas fa-chart-bar"></i>
          <span>Reportes</span>
        </a>
      </nav>
    </div>

    <!-- Content Area -->
    <div class="content">
      <main class="main-content">
        <?= $content ?? 'Contenido del dashboard se cargará aquí' ?>
        
        <!-- Ejemplo de contenido de dashboard -->
        <div class="row mt-4">
          <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">
                <h5 class="card-title"><i class="fas fa-calendar-check text-primary me-2"></i>Próxima Cita</h5>
                <p class="card-text">No tienes citas programadas</p>
                <a href="/vetsmart/cliente/citas" class="btn btn-sm btn-outline-primary">Agendar Cita</a>
              </div>
            </div>
          </div>
          <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">
                <h5 class="card-title"><i class="fas fa-paw text-secondary me-2"></i>Mis Mascotas</h5>
                <p class="card-text">Tienes 2 mascotas registradas</p>
                <a href="/vetsmart/cliente/mascotas" class="btn btn-sm btn-outline-secondary">Gestionar Mascotas</a>
              </div>
            </div>
          </div>
        </div>
      </main>

      <footer>
        © <?= date("Y") ?> VetSmart. Todos los derechos reservados.
      </footer>
    </div>
  </div>

</body>
</html>
